{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    // Vite swaps `@echo-web` between the real WASM module and a desktop stub at
    // build time (see vite.config.ts). tsc only needs one target to type-check
    // against — both files share the same `initWeb` signature, so pointing at
    // the real one covers both builds.
    "paths": {
      "@echo-web": ["./src/lib/echo-web.ts"],
    },
  },
  "include": ["src"],
}
