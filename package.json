{
  "name": "blacksmith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "build:wasm": "cd crates/echo-node && cargo build --target=wasm32-unknown-unknown && wasm-bindgen ./target/wasm32-unknown-unknown/debug/echo_node.wasm --out-dir=../../src/wasm --weak-refs --target=web --debug",
    "build:wasm:release": "cd crates/echo-node && cargo build --target=wasm32-unknown-unknown --release && wasm-bindgen ./target/wasm32-unknown-unknown/release/echo_node.wasm --out-dir=../../src/wasm --weak-refs --target=web && wasm-opt --enable-nontrapping-float-to-int --enable-bulk-memory -Os -o ../../src/wasm/echo_node_bg.wasm ../../src/wasm/echo_node_bg.wasm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "~2.5.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "diff": "^9.0.0",
    "idb": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
